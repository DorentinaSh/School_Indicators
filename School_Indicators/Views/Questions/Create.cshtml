@model School_Indicators.BO.Question
@{
    ViewBag.Title = "Create";
}
    <div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>
<div class="row">
    <h3>Questionnaire: @Model.QuestionnaireName</h3>
    <h3>Create Question for Category: @Model.CategoryName</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" />
        </div>
    </div>
    <div class="col-md-12">
        <div class="form-group">
            <label class="control-label">Question Type</label>
            <select id="QuestionTypeID" class="form-control" name="QuestionTypeID">
                <option value="0"></option>
                @foreach (var item in Model.types)
                {
                    <option value="@item.Id">@item.Name1</option>
                }
            </select>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in Albanian</label>
            <input type="text" class="form-control" id="Name1" name="Name1" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in English</label>
            <input type="text" class="form-control" id="Name2" name="Name2" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in Srpsko</label>
            <input type="text" class="form-control" id="Name3" name="Name3" />
        </div>
    </div>
    <div class="col-md-12">
        <button type="button" onclick="SaveQuestionnaire(@Model.CategoryId)" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>

<script>
    function SaveQuestionnaire(_id) {

        var frm = {
            'CategoryId': _id,
            'QuestionTypeID': $('#QuestionTypeID').val(),
            'Name1': $('#Name1').val(),
            'Name2': $('#Name2').val(),
            'Name3': $('#Name3').val(),
            'IsActive': $('#IsActive').prop('checked')
        };

        console.log(frm);

        $.ajax({
            type: "POST",
            url: '@Url.Action("CreateQuestion", "Questions")',
            data: JSON.stringify({
                model: frm
            }),
            cache: false,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                console.log('response', response);
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
</script>