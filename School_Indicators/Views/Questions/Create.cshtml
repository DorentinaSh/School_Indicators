                    <div class="form-group">
                        <label class="control-label">Option in English</label>
                        <br />
                        <label class="control-label answers">Yes</label>
                        @*<input type="text" id="optionsEng_0" class="form-control" />*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in Srpsko</label>
                        <br />
                        <label class="control-label answers">да</label>
                        @*<input type="text" id="optionsSrp_0" class="form-control" />*@
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-1">
                    <div class="form-group">
                        <label class="control-label">2</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in Albanian</label>
                        <br />
                        <label class="control-label answers">NDOSHTA</label>
                        @*<input type="text" id="optionsAlb_1" class="form-control input-validation-error opt" data-val="true" data-val-required="Emri i Opsionit 2 &#235;sht&#235; obligative" aria-invalid="true" />*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in English</label>
                        <br />
                        <label class="control-label answers">PERHAPS</label>
                        @*<input type="text" id="optionsEng_1" class="form-control" />*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in Srpsko</label>
                        <br />
                        <label class="control-label answers">ПЕРХАПС</label>
                        @*<input type="text" id="optionsSrp_kk1" class="form-control" />*@
                    </div>
                </div>
            </div> 
            <div class="row">
                <div class="col-md-1">
                    <div class="form-group">
                        <label class="control-label">3</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in Albanian</label>
                        <br />
                        <label class="control-label answers">JO</label>
                        @*<input type="text" id="optionsAlb_1" class="form-control input-validation-error opt" data-val="true" data-val-required="Emri i Opsionit 2 &#235;sht&#235; obligative" aria-invalid="true" />*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in English</label>
                        <br />
                        <label class="control-label answers">NO</label>
                        @*<input type="text" id="optionsEng_1" class="form-control" />*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="control-label">Option in Srpsko</label>
                        <br />
                        <label class="control-label answers">НЕ</label>
                        @*<input type="text" id="optionsSrp_kk1" class="form-control" />*@
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <button type="button" onclick="SaveQuestion()" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>
<script>
    function SaveQuestion() {
        var question = {
            'QuestionTypeID': $("#QuestionTypeID option:selected").val() ,
            'Name1': $('#Name1').val(),
            'Name2': $('#Name2').val(),
            'Name3': $('#Name3').val(),
            'IsActive': $('#IsActive').prop('checked')
        };

        var optionsList = [];
        for (var i = 0; i < option; i++) {
            var optionObj = {
                'Name1': $('#optionsAlb_' + i ).val(),
                'Name1': $('#optionsAlb_' + i ).val(),
                'Name2': $('#optionsEng_' + i ).val(),
                'Name3': $('#optionsSrp_' + i ).val(),
            };
            optionsList.push(optionObj);
        };

        var catQuest = {
            'CategoryId': $("#CategoryId option:selected").val(),
            'QuestionnaireId': @ViewBag.QuestionnaireId,
        };

        $.ajax({
            type: "POST",
            url: '@Url.Action("CreateQuestion", "Questions")',
            data: JSON.stringify({
                question: question,
                optionsList: optionsList,
                catQuest: catQuest
            }),
            cache: false,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                if (response.success) {
                    window.location.href = '/Questions/Index';
                }
            },
            error: function (err) {
                console.log(err);
            }
        });
    }

    $('#QuestionTypeID').change(function () {
        $("#moreoptions").empty();
        $('.opt').val(null);
        option = 2;
        if (option < 5) {
            $("#addmore").show();
        }
        var type = $("#QuestionTypeID :selected").val();
        console.log(type);
        switch (type) {
            case "2":
                $(".options").hide();
                break;
            case "4":
                $(".options").show();
                break;
            case "6":
                $(".options").show();
            default:
        }
    });
</script>