@model List<School_Indicators.BO.Question>
@{
    ViewBag.Title = "Index";
}
<style>
    .hide_column {
        display: none;
    }
    .btnList {
        display: inline-block;
        margin-bottom: 0;
        font-weight: normal;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        -ms-touch-action: manipulation;
        touch-action: manipulation;
        cursor: pointer;
        background-image: none;
        border: 1px solid transparent;
        padding: 8px 11px;
        font-size: 15px;
        line-height: 0.2;
        border-radius: 4px;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
<div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>

<div class="row">
    <h3>List of questions of questionnaire "@ViewBag.Name" </h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <a class="btn btn-primary" href="/Questions/Create?id=@ViewBag.QuestionnaireID">Add New <i class="glyphicon glyphicon-plus"></i></a>
    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover" id="questions">
                <thead>
                    <tr>
                        <th></th>
                        <th>Indicator name</th>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        LoadQuestionnaireDataTable();
    });

    function LoadQuestionnaireDataTable() {
        $("#questions").DataTable({
            "ajax": {
                "url": "/Questions/GetAll",
                "type": "GET",
                "datatype": "json",
            },
            "columns": [
                { "data": "Id", "className": "hide_column" },
                { "data": "IndicatorName" },
                { "data": "Name1" },
                { "data": "Name2" },
                { "data": "Name3" },
                {
                    "data": "IsActive", render: function (data, type, row) {
                        if (data) {
                            return '<input data="' + row.isActive + '" type="checkbox" name="my-checkbox" checked>';
                        } else {
                            return '<input data="' + row.isActive + '" type="checkbox" name="my-checkbox" >';
                        }
                    }
                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btnList btn-default" onclick="ShowOptions(this)"  title="View Options"' + '>' + '<span class="glyphicon glyphicon-list" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btnList btn-warning" onclick="EditQuestion(this)"  title="Edit Question"' + '>' + '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btnList btn-danger " onclick="DeleteQuestions(this)"  title="Delete Question"' + '>' + '<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>' + '</a>'; }
                },
            ],
            "language": {
                "lengthMenu": 'Shfaq <select>' +
                    '<option value="5">5</option>' +
                    '<option value="10">10</option>' +
                    '<option value="25">25</option>' +
                    '<option value="50">50</option>' +
                    '<option value="-1">All</option>' +
                    '</select> rekorde',
                "zeroRecords": "Nuk u gjet asnjë rekord",
                "info": "Faqja _PAGE_ nga _PAGES_",
                "infoEmpty": "Asnjë rekord në dispozicion",
                "infoFiltered": "(filtruar nga _MAX_ rekorde gjithesej)",
                "sSearch": "Kërko",
                "oPaginate": {
                    "sPrevious": "Pas",
                    "sNext": "Para"
                },
            }
        });
    }


    function EditQuestion(obj) {
        var currow = $(obj).closest('tr');
        var col2 = currow.find('td:eq(0)').text();
        window.location.href = '/Questions/Edit?id=' + col2;
    }

    function DeleteQuestions(_this) {
         var currow = $(_this).closest('tr');
        var _id = currow.find('td:eq(0)').text();
        Swal.fire({
            title: 'Are you sure?',
            text: 'You will not be able to recover this record!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel!',
        }).then((result) => {
            console.log(_id);
                if (result.value) {
                    $.ajax({
                         type: "POST",
                         url: '@Url.Action("DeleteQuestion", "Questions")',
                         data: JSON.stringify({
                             'id': _id
                         }),
                         dataType: "json",
                         contentType: "application/json; charset=utf-8",
                         success: function (response) {
                             location.reload();
                         },
                         error: function (err) {
                             location.reload();
                             console.log(err);
                         }
                     });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire(
                        'Cancelled',
                        'Your recored is not deleted!',
                        'error'
                    )
                }
            })
    }
</script>