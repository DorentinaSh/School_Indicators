@model List<School_Indicators.BO.Questionnaries>
@{
    ViewBag.Title = "Index";
}
<div class="row">
    <h3>List of questionnaires</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <a class="btn btn-primary" href="/Questionnaire/Create">Add New <i class="glyphicon glyphicon-plus"></i></a>
    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover" id="questionnaire">
                <thead>
                    <tr>
                        <th>Hide Id</th>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th>Nrysho</th>
                        <th>Fshij</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script>


    $(document).ready(function () {
        LoadQuestionnaireDataTable();
    });

    function LoadQuestionnaireDataTable() {
        $("#questionnaire").DataTable({
            "ajax": {
                "url": "/Questionnaire/GetAll",
                "type": "GET",
                "datatype": "json"
            },
            "columns": [
                { "data": "Id", "className": "hide_column" },
                { "data": "Name1" },
                { "data": "Name2" },
                { "data": "Name3" },
                { "data": "IsActive" },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-warning" onclick="EditInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-danger" onclick="DeleteInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>' + '</a>'; }
                },
            ],
            "language": {
                "lengthMenu": "Shfaq _MENU_ rekorde për faqe",
                "zeroRecords": "Nuk u gjet asnjë rekord",
                "info": "Faqja _PAGE_ nga _PAGES_",
                "infoEmpty": "Asnjë rekord në dispozicion",
                "infoFiltered": "(filtruar nga _MAX_ rekorde gjithesej)",
                "sSearch": "Kërko",
                "oPaginate": {
                    "sPrevious": "Pas",
                    "sNext": "Para"
                },
            }
        });
    }

    function DeleteQuestionnaire(_id) {
        Swal.fire({
            title: 'Are you sure?',
            text: 'You will not be able to recover this record!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel!',
        }).then((result) => {
                if (result.value) {
                    $.ajax({
                         type: "POST",
                         url: '@Url.Action("DeleteQuestionnarie", "Questionnaire")',
                         data: JSON.stringify({
                             'id': _id
                         }),
                         dataType: "json",
                         contentType: "application/json; charset=utf-8",
                         success: function (response) {
                             location.reload();
                         },
                         error: function (err) {
                             console.log(err);
                         }
                     });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire(
                        'Cancelled',
                        'Your recored is not deleted!',
                        'error'
                    )
                }
            })
    }
</script>