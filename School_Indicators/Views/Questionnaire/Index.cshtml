@model List<School_Indicators.BO.Questionnaries>
@{
    ViewBag.Title = "Index";
}
<div class="row">
    <h3>List of questionnaires</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <a class="btn btn-primary" href="/Questionnaire/Create">Add New <i class="glyphicon glyphicon-plus"></i></a>
    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover">
                <thead>
                    <tr>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name1</td>
                            <td>@item.Name2</td>
                            <td>@item.Name3</td>
                            <td><input type="checkbox" disabled id="IsActive" name="IsActive" @(item.IsActive ? "checked" : String.Empty) /></td>
                            <td>
                                <div class="pull-right">
                                    <a class="btn btn-xs btn-info" href="/Questions/Index?id=@item.Id" data-toggle="tooltip" data-placement="top" title="View Questions"><i class="glyphicon glyphicon-arrow-right"></i></a>
                                    @*<a class="btn btn-xs btn-info" href="/Categories/Index?id=@item.Id" data-toggle="tooltip" data-placement="top" title="View Categories"><i class="glyphicon glyphicon-arrow-right"></i></a>*@
                                    <a class="btn btn-xs btn-info" href="/Questionnaire/Edit?id=@item.Id"><i class="glyphicon glyphicon-edit"></i></a>
                                    <button class="btn btn-xs btn-danger" type="button" onclick="DeleteQuestionnaire(@item.Id)"><i class="glyphicon glyphicon-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>

    //$(document).ready(function () {
    //    Swal.fire({
    //        title: 'Error!',
    //        text: 'Do you want to continue',
    //        icon: 'error',
    //        confirmButtonText: 'Cool'
    //    })
    //});

    function DeleteQuestionnaire(_id) {
        Swal.fire({
            title: 'Are you sure?',
            text: 'You will not be able to recover this record!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel!',
        }).then((result) => {
                if (result.value) {
                    $.ajax({
                         type: "POST",
                         url: '@Url.Action("DeleteQuestionnarie", "Questionnaire")',
                         data: JSON.stringify({
                             'id': _id
                         }),
                         dataType: "json",
                         contentType: "application/json; charset=utf-8",
                         success: function (response) {
                             location.reload();
                         },
                         error: function (err) {
                             console.log(err);
                         }
                     });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire(
                        'Cancelled',
                        'Your recored is not deleted!',
                        'error'
                    )
                }
            })
    }
</script>