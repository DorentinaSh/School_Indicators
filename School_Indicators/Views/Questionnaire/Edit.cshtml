@model School_Indicators.BO.Questionnaries
@{
    ViewBag.Title = "Create";
}
    <div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>
<div class="row">
    <h3>Edit Questionnarie</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" @(Model.IsActive ? "checked" : String.Empty) />
        </div>
    </div>
    <div class="col-md-7">
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">Name in Albanian</label>
                <input type="text" class="form-control" id="Name1" name="Name1" value="@Model.Name1" />
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">Name in English</label>
                <input type="text" class="form-control" id="Name2" name="Name2" value="@Model.Name2" />
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">Name in Srpsko</label>
                <input type="text" class="form-control" id="Name3" name="Name3" value="@Model.Name3" />
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="col-md-12">
            <div class="form-group">
                <label class="control-label">Description</label>
                <textarea class="form-control" id="Description" name="Description" >@Model.Description</textarea>
            </div>
        </div>
    </div>
    <div class="col-md-12">
        <button type="button" onclick="SaveQuestionnaire(@Model.Id)" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>

<script>
   function SaveQuestionnaire(id) {

       var frm = {
           'Id': id,
           'Name1': $('#Name1').val(),
           'Name2': $('#Name2').val(),
           'Name3': $('#Name3').val(),
           'Description': $('#Description').val(),
           'IsActive': $('#IsActive').prop('checked')
       };

       $.ajax({
           type: "POST",
           url: '@Url.Action("UpdateQuestionnarie", "Questionnaire")',
           data: JSON.stringify({
               model: frm
           }),
           cache: false,
           dataType: "json",
           contentType: "application/json; charset=utf-8",
           success: function (response) {
               if (response.success) {
                   window.location.href = '/Questionnaire/Index';
               }
           },
           error: function (err) {
               console.log(err);
           }
       });
    }
</script>