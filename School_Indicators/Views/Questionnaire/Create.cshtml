@model School_Indicators.BO.Questionnaries
@{
    ViewBag.Title = "Create";
}
    <div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>
<div class="row">
    <h3>Create Questionnarie</h3>
    <hr />
</div>
<div class="row">
    @*<div class="col-md-12">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" checked/>
        </div>
    </div>*@
    <div class="col-md-7">
        <div class="col-md-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Name1, htmlAttributes: new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name1, null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name1, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Name2, htmlAttributes: new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name2, null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name2, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                @Html.LabelFor(model => model.Name3, htmlAttributes: new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name3, null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name3, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="form-group">
            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label" })
            @Html.TextAreaFor(model => model.Description, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <button type="button" onclick="SaveQuestionnaire()" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>

<script>
    function SaveQuestionnaire() {
        var frm = {
            'Name1': $('#Name1').val(),
            'Name2': $('#Name2').val(),
            'Name3': $('#Name3').val(),
            'Description': $('#Description').val(),
            'IsActive': $('#IsActive').prop('checked')
        };

        $.ajax({
            type: "POST",
            url: '@Url.Action("CreateQuestionnarie", "Questionnaire")',
            data: JSON.stringify({
                model: frm
            }),
            cache: false,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                if (response.success) {
                    window.location.href = '/Questionnaire/Index';
                }
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
</script>