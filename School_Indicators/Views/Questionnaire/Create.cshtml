@model School_Indicators.BO.Questionnaries
@{
    ViewBag.Title = "Create";
}
<br />
<br />
<div class="row">
    <h3>Create Questionnarie</h3>
    <hr />
</div>
<div class="row">
    @using (Html.BeginForm("Create", "Questionnaire", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
    {
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Name in Albanian</label>
                <input type="text" class="form-control" id="Name1" name="Name1" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Name in English</label>
                <input type="text" class="form-control" id="Name2" name="Name2" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label class="control-label">Name in Srpsko</label>
                <input type="text" class="form-control" id="Name2" name="Name2" />
            </div>
        </div>
        <div class="col-md-12">
            <button type="submit" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
        </div>
    }
</div>