<style>
    .collapsible {
        background-color: #777;
        color: white;
        cursor: pointer;
        padding: 18px;
        width: 100%;
        border: none;
        text-align: left;
        outline: none;
        font-size: 15px;
        border: 1px solid #dadce0;
        border-radius: 8px;
        box-shadow: none;
    }

        .active, .collapsible:hover {
            background-color: #555;
        }

        .collapsible:after {
            content: '\002B';
            color: white;
            font-weight: bold;
            float: right;
            margin-left: 5px;
        }

    .active:after {
        content: "\2212";
    }

    .content {
        padding: 0 20px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.2s ease-out;
        background-color: #f1f1f1;
    }

    .formatedFields {
        flex-direction: column;
        background-color: #fff;
        margin-top: 10px;
        position: relative;
        display: flex;
        transition: box-shadow 280ms cubic-bezier(0.4,0.0,0.2,1);
        border: 1px solid #dadce0;
        border-radius: 8px;
        box-shadow: none;
    }

    .formatedThemeStripe {
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        height: 10px;
        left: -1px;
        position: absolute;
        top: -1px;
        width: calc(100% + 2px);
        background-color: #FB6060;
        color: rgba(255, 255, 255, 1);
    }

    .formatedViewCursorRoot {
        height: calc(100% + -8px);
        display: flex;
        left: -1px;
        padding-right: 10px;
        overflow-wrap: break-word;
        position: absolute;
        bottom: -1px;
        width: 6px;
    }

    .formatedViewCursorColorContainer {
        flex-direction: column;
        -webkit-box-flex: 1;
        flex-grow: 1;
        display: flex;
    }

    input[type=text] {
        display: inline-block;
        width: 100%;
        padding: 12px 20px;
        margin: 15px;
        box-sizing: border-box;
        border: none;
        border-bottom: 2px solid #808080;
    }

        input[type=text]:focus {
            width: 100%;
            outline: none;
            box-sizing: border-box;
            border: none;
            border-bottom: 2px solid #FB6060;
        }

    .title {
        font-size: 28px;
    }

    .textarea {
        display: inline-block;
        width: 100%;
        padding: 12px 20px;
        margin: 15px;
        box-sizing: border-box;
        border: none;
        border-bottom: 2px solid #808080;
    }

        .textarea:focus {
            width: 100%;
            outline: none;
            box-sizing: border-box;
            border: none;
            border-bottom: 2px solid #FB6060;
        }
    #newQuestionContent {
        border-top: 1px solid #808080;
    }
</style>
