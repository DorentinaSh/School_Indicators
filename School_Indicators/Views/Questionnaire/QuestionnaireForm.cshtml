@model School_Indicators.BO.Questionnaries

@{
    ViewBag.Title = "Questionnaire Form";
}
<style>
    .title {
        text-align: center;
        padding-left:-30px;
    }

    p {
        text-align: left;
    }

    .indicatorTitle {
        font: 20px Helvetica, Sans-Serif;
        letter-spacing: 1px;
        color: rgba(0, 23, 117, 0.74);
        font-weight: 700;
    }

    .title {
        font: 35px Helvetica, Sans-Serif;
        letter-spacing: 1px;
        /*font-weight: 800;*/
    }

    .questions {
        padding: 10px;
    }

    .questionTitle {
        font: Helvetica, Sans-Serif;
        font-weight: bold;
    }
</style>

<div>
    <div class="row">
        <div class="col-md-12">
            <div class="col-md-1" style="align-items:center;">
                <br />
                <a class="btn btn-info" onclick="DownloadFile()" data-toggle="tooltip" data-placement="top" title="Download file">
                    <span class="glyphicon glyphicon-save" aria-hidden="true"></span>
                </a>
            </div>
            <div class="col-md-11">
                <h2 class="title">@Model.Name1</h2>

            </div>

            <hr />
        </div>
        <div class="col-md-8">
            <div class="form-group">
                <br />
                <p class="control-label" style="font-weight: bold;">Description</p>
                <p class="control-label" @*style="font-style: italic;"*@>@Model.Description</p>
            </div>
        </div>
        <div class="col-md-1">
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <br />
                <p class="control-label" style="font-weight:bold;">Created Date</p>
                <p class="control-label">@Model.InsertDate.ToString()</p>
            </div>
        </div>
    </div>
    <div class="row">
        @if (Model.Indicators.Count > 0)
        {
            foreach (School_Indicators_BO.BO.Indicator item in Model.Indicators)
            {
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <hr />
                            @*<input id="indictorID" value="@item.Id" hidden />*@
                            <p class="control-label indicatorTitle"><span class="glyphicon glyphicon-minus" aria-hidden="true"></span> @item.Name1</p>
                        </div>
                    </div>
                    <div class="col-md-12">
                        @foreach (School_Indicators.BO.Question item1 in item.Questions)
                        {
                            <div class="row questions">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <p class="control-label questionTitle">@item1.Name1</p>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    @foreach (School_Indicators.BO.QuestionOption item2 in item1.Options)
                                    {
                                        <div class="row">
                                            <div class="col-md-1">
                                                <input type="radio" disabled>
                                            </div>
                                            <div class="col-md-11">
                                                <p class="control-label">@item2.Name1</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                        }
                    </div>
                </div>
                <br />
            }
        }
    </div>
</div>

<script></script>