@model School_Indicators.BO.Institution
@{
    ViewBag.Title = "Create";
}
<div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>
<div class="row">
    <h3>Create institution</h3>
    <hr />
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" checked />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.InstitutionsNo, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.InstitutionsNo, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.InstitutionsNo, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.TelephoneNo, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.TelephoneNo, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.TelephoneNo, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.Name1, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Name1, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Name1, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.Name2, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Name2, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Name2, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.Name3, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Name3, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Name3, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="row">

    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.Location, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Location, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Location, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.CityID, "City", htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(m => m.CityID, (SelectList)ViewBag.City, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CityID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.Address, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.Address, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <button type="submit" class="btn btn-success pull-right" onclick="SaveInstitution()">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>

<script>
    function SaveInstitution() {

        var frm = {
            'IsActive': $('#IsActive').prop('checked'),
            'InstitutionsNo': $('#InstitutionsNo').val(),
            'TelephoneNo': $('#TelephoneNo').val(),
            'Name1': $('#Name1').val(),
            'Name2': $('#Name2').val(),
            'Name3': $('#Name3').val(),
            'Location': $('#Location').val(),
            'Address': $('#Address').val(),
            'CityID': $("#CityID option:selected").val(),
        };

        console.log(frm);

        $.ajax({
            type: "POST",
            url: '@Url.Action("Create", "Institution")',
            data: JSON.stringify({
                model: frm
            }),
            cache: false,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                if (response.success) {
                    window.location.href = '/Institution/Index';
                }
            },
            error: function (err) {
                console.log(err);
            }
        });
        }
</script>
