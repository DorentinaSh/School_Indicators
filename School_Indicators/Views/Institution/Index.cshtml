@{
    ViewBag.Title = "Index";
}
<br />
<br />
<div class="row">
    <div class="col-md-12">
        <a class="btn btn-primary" href="/Instituion/Create">Add New <i class="glyphicon glyphicon-plus"></i></a>
    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover">
                <thead>
                    <tr>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name1</td>
                            <td>@item.Name2</td>
                            <td>@item.Name3</td>
                            <td>
                                <div class="pull-right">
                                    <a class="btn btn-xs btn-info" href="/Questionnaire/Edit?id=@item.ID"><i class="glyphicon glyphicon-edit"></i></a>
                                    <button class="btn btn-xs btn-danger" onclick="DeleteQuestionnaire()"><i class="glyphicon glyphicon-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>