@{
    ViewBag.Title = "Index";
}


<style>
    .hide_column {
        display: none;
    }
</style>
<div class="row">
        <h3>List of Institutions</h3>
        <hr />
    </div>
    <div class="row">
        <div class="col-md-12">
            <a class="btn btn-primary" href="/Institution/Create">Add New    <i class="glyphicon glyphicon-plus"></i></a>
        </div>
        <div class="col-md-12">
            <hr />
            <div class="table-responsive">
                <table class="table table-hover table-condensed table-condensed table-striped table-hover" id="institutions">
                    <thead>
                        <tr>
                            <th>Hide Id</th>
                            <th>Institution No</th>
                            <th>Shqip</th>
                            <th>English</th>
                            <th>Srpsko</th>
                            <th>Is Active</th>
                            <th>Ndrysho</th>
                            <th>Fshij</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

<script>

    $(document).ready(function () {
        LoadInstitutionsDataTable();
    });

        function LoadInstitutionsDataTable() {
            $("#institutions").DataTable({
            "ajax": {
                "url": "/Institution/GetAll",
                "type": "GET",
                "datatype": "json"
            },
            "columns": [
                { "data": "Id", "className": "hide_column"  },
                { "data": "InstitutionsNo" },
                { "data": "Name1" },
                { "data": "Name2" },
                { "data": "Name3" },
                { "data": "IsActive" },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-warning" onclick="EditInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-danger" onclick="DeleteInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>' + '</a>'; }
                },
            ],
            "language": {
                "lengthMenu": "Shfaq _MENU_ rekorde për faqe",
                "zeroRecords": "Nuk u gjet asnjë rekord",
                "info": "Faqja _PAGE_ nga _PAGES_",
                "infoEmpty": "Asnjë rekord në dispozicion",
                "infoFiltered": "(filtruar nga _MAX_ rekorde gjithesej)",
                "sSearch": "Kërko",
                "oPaginate": {
                    "sPrevious": "Pas",
                    "sNext": "Para"
                },
            }
        });
    }

    function EditInstitution(obj) {
        var currow = $(obj).closest('tr');
        var col2 = currow.find('td:eq(0)').text();
        window.location.href = '/Institution/Edit?id=' + col2;
    }

    function DeleteInstitution(_this) {
        var currow = $(_this).closest('tr');
        var _id = currow.find('td:eq(0)').text();
         Swal.fire({
            title: 'Are you sure?',
            text: 'You will not be able to recover this record!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel!',
        }).then((result) => {
                if (result.value) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("DeleteInstitution", "Institution")',
                        data: JSON.stringify({
                            'id': _id
                        }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (response) {
                            console.log('response', response);
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire(
                        'Cancelled',
                        'Your recored is not deleted!',
                        'error'
                    )
                }
            })

    }
</script>