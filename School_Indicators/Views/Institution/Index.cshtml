    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover" id="instituions">
                <thead>
                    <tr>
                        <th></th>
                        <th>Institution No</th>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th></th>
                    </tr>
                </thead>
                @*<tbody>
                    @foreach (var item in Model)
                    {
