<div class="container">
    <div class="row">
        <div class="form-group" style="position:relative">
            <div class="myInlineElements">
                <h2>Lista e Institucioneve</h2>
            </div>
            <div class="myInlineElements">
                <a class="btn btn-success" href="@Url.Action("Institution", "Create")">
                    Add
                </a>
            </div>
        </div>
        <div style="width:90%;margin-left:15px; margin-top:10px">
            <table id="institutions" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Hide Id</th>
                        <th>Institution No</th>
                        <th>Shqip</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th>Ndrysho</th>
                        <th>Fshij</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        LoadInstitutionsDataTable();
    });

        function LoadInstitutionsDataTable() {
            $("#institutions").DataTable({
            serverSide: true,
            "ajax": {
                "url": "/Institution/GetAll",
                "type": "GET",
                "datatype": "json",
                "paging": "false"
            },
            "columns": [
                { "data": "Id", "className": "hide_column"  },
                { "data": "InstitutionsNo" },
                { "data": "Name1" },
                { "data": "Name2" },
                { "data": "Name3" },
                { "data": "IsActive" },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-warning" onclick="EditInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btn btn-danger" onclick="DeleteInstitution(this)" ' + '>' + '<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>' + '</a>'; }
                },
            ],
        });
    }

