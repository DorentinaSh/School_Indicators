@model School_Indicators.BO.Institution
@{
    ViewBag.Title = "Create";
}
    <div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>

<div class="row">
    <h3>Edit Institution Information</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" @(Model.IsActive ? "checked" : String.Empty) />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Institution No.</label>
            <input type="number" min="0" class="form-control" id="InstitutionNo" name="InstitutionNo" value="@Model.InstitutionsNo" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Telephone No</label>
            <input type="tel" class="form-control" id="TelNo" name="TelNo" value="@Model.TelephoneNo" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in Albanian</label>
            <input type="text" class="form-control" id="Name1" name="Name1" value="@Model.Name1" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in English</label>
            <input type="text" class="form-control" id="Name2" name="Name2" value="@Model.Name2" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Name in Srpsko</label>
            <input type="text" class="form-control" id="Name3" name="Name3" value="@Model.Name3" />
        </div>
    </div>
</div>
<div class="row">

    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Location</label>
            <input type="text" class="form-control" id="Location" name="Location" value="@Model.Location" />
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.CityID, "City", htmlAttributes: new { @class = "control-label" })
            @Html.DropDownListFor(m => m.CityID, (SelectList)ViewBag.City, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CityID, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            <label class="control-label">Address</label>
            <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <button type="submit" class="btn btn-success pull-right" onclick="UpdateInstitution(@Model.Id)">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>
<script>
   function UpdateInstitution(id) {

       var frm = {
           'Id': id,
           'IsActive': $('#IsActive').prop('checked'),
           'InstitutionsNo': $('#InstitutionNo').val(),
           'TelephoneNo': $('#TelNo').val(),
           'Name1': $('#Name1').val(),
           'Name2': $('#Name2').val(),
           'Name3': $('#Name3').val(),
           'Location': $('#Location').val(),
           'Address': $('#Address').val(),
           'CityID': $("#CityID option:selected").val(),
       };

        console.log(frm);

       $.ajax({
           type: "POST",
           url: '@Url.Action("UpdateInstitution", "Institution")',
           data: JSON.stringify({
               model: frm
           }),
           cache: false,
           dataType: "json",
           contentType: "application/json; charset=utf-8",
           success: function (response) {
               if (response.success) {
                   window.location.href = '/Institution/Index';
               }
           },
           error: function (err) {
               console.log(err);
           }
       });
    }
</script>