@model School_Indicators_BO.BO.CategoryOfQuestion
@{
    ViewBag.Title = "Create";
}
    <div class="row" style="float:right;"><a href="javascript:void(0);" onclick="history.go(-1);"><i class="glyphicon glyphicon-arrow-left"></i>  Back</a></div>

<div class="row">
    <h3>Create Category</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <div class="form-group" style="float:left;">
            <label class="control-label">Is Active?</label>
            <input type="checkbox" class="form-control" id="IsActive" name="IsActive" checked />
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.CategoryName, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.CategoryName2, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.CategoryName2, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CategoryName2, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group">
            @Html.LabelFor(model => model.CategoryName3, htmlAttributes: new { @class = "control-label" })
            @Html.TextBoxFor(model => model.CategoryName3, null, htmlAttributes: new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CategoryName3, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-12">
        <button type="button" onclick="SaveCategories()" class="btn btn-success pull-right">Save <i class="glyphicon glyphicon-floppy-disk"></i></button>
    </div>
</div>

<script>
    function SaveCategories() {

        var frm = {
            'CategoryName': $('#CategoryName').val(),
            'CategoryName2': $('#CategoryName2').val(),
            'CategoryName3': $('#CategoryName3').val(),
            'IsActive': $('#IsActive').prop('checked')
        };

        console.log(frm);

        $.ajax({
            type: "POST",
            url: '@Url.Action("CreateCategory", "Categories")',
            data: JSON.stringify({
                model: frm
            }),
            cache: false,
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                window.location.href = '/Categories/Index';
            },
            error: function (err) {
                console.log(err);
            }
        });
    }
</script>

