@model List<School_Indicators_BO.BO.Indicator>
@{
    ViewBag.Title = "Index";
}

<style>
    .hide_column {
        display: none;
    }

    .btnList {
        display: inline-block;
        margin-bottom: 0;
        font-weight: normal;
        text-align: center;
        white-space: nowrap;
        vertical-align: middle;
        -ms-touch-action: manipulation;
        touch-action: manipulation;
        cursor: pointer;
        background-image: none;
        border: 1px solid transparent;
        padding: 8px 11px;
        font-size: 15px;
        line-height: 0.2;
        border-radius: 4px;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }
</style>
<div class="row">
    <h3>List of indicators</h3>
    <hr />
</div>
<div class="row">
    <div class="col-md-12">
        <a class="btn btn-primary" href="/Categories/Create">Add New <i class="glyphicon glyphicon-plus"></i></a>
    </div>
    <div class="col-md-12">
        <hr />
        <div class="table-responsive">
            <table class="table table-hover table-condensed table-condensed table-striped table-hover" id="categories">
                <thead>
                    <tr>
                        <th>Hide Id</th>
                        <th>Albanian</th>
                        <th>English</th>
                        <th>Srpsko</th>
                        <th>Is Active</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        Load_Categories_DataTable();
    });
    function Load_Categories_DataTable() {
        $("#categories").DataTable({
            "ajax": {
                "url": "/Categories/GetAll",
                "type": "GET",
                "datatype": "json"
            },
            "columns": [
                { "data": "Id", "className": "hide_column" },
                { "data": "Name1" },
                { "data": "Name2" },
                { "data": "Name3" },
                {
                    "data": "IsActive", render: function (data, type, row) {
                        if (data) {
                            return '<input data="' + row.isActive + '" type="checkbox" name="my-checkbox" disabled checked>';
                        } else {
                            return '<input data="' + row.isActive + '" type="checkbox" name="my-checkbox" disabled>';
                        }
                    }
                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btnList btn-warning" onclick="EditCategory(this)" ' + '>' + '<span class="glyphicon glyphicon-edit" aria-hidden="true"></span>' + '</a>'; }

                },
                {
                    "mData": null,
                    "bSortable": false,
                    "width": "1px",
                    "mRender": function (o) { return '<a class="btnList btn-danger" onclick="DeleteCategory(this)" ' + '>' + '<span class="glyphicon glyphicon-remove" aria-hidden="true"></span>' + '</a>'; }
                },
            ],
            "language": {
                "lengthMenu": 'Show <select>' +
                    '<option value="5">5</option>' +
                    '<option value="10">10</option>' +
                    '<option value="25">25</option>' +
                    '<option value="50">50</option>' +
                    '<option value="-1">All</option>' +
                    '</select> records',
                "zeroRecords": "There is no records",
                "info": "Page _PAGE_ from _PAGES_",
                "infoEmpty": "There is no records",
                "infoFiltered": "(filtered from _MAX_ records)",
                "sSearch": "Search",
                "oPaginate": {
                    "sPrevious": "Previous",
                    "sNext": "Next"
                },
            }
        });
    }

    function EditCategory(obj) {
        var currow = $(obj).closest('tr');
        var col2 = currow.find('td:eq(0)').text();
        window.location.href = '/Categories/Edit?id=' + col2;
    }
    function DeleteCategory(_this) {
        var currow = $(_this).closest('tr');
        var _id = currow.find('td:eq(0)').text();
         Swal.fire({
            title: 'Are you sure?',
            text: 'You will not be able to recover this record!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel!',
        }).then((result) => {
                if (result.value) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("DeleteCategory", "Categories")',
                        data: JSON.stringify({
                            'id': _id
                        }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (response) {
                            location.reload();
                        },
                        error: function (err) {
                            console.log(err);
                        }
                    });
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                    Swal.fire(
                        'Cancelled',
                        'Your recored is not deleted!',
                        'error'
                    )
                }
            })

    }
</script>